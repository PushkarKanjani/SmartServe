# ==============================================================================
# SmartServe Backend Environment Configuration (Template / Example)
# Copy this file to .env and fill in your values.
# NEVER commit your actual .env file or real credentials to source control.
# ==============================================================================

# Application Metadata
APP_NAME=SmartServe
ENVIRONMENT=dev

# Database Configuration (Supabase PostgreSQL)
DATABASE_URL=postgresql://<username>:<password>@<host>:5432/<dbname>?sslmode=require

# JWT Security
JWT_SECRET_KEY=<your_jwt_secret_key_32_characters_minimum>
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Redpanda Cloud / Apache Kafka Configuration
KAFKA_ENABLED=true
KAFKA_BOOTSTRAP_SERVERS=<bootstrap_server_url>:9092
KAFKA_CONSUMER_GROUP=smartserve-backend-group
KAFKA_SECURITY_PROTOCOL=SASL_SSL
KAFKA_SASL_MECHANISM=SCRAM-SHA-256
KAFKA_SASL_USERNAME=smartserve-production
KAFKA_SASL_PASSWORD=<your_redpanda_sasl_password>

# AI Support / OpenRouter
OPENROUTER_API_KEY=<your_openrouter_api_key>
OPENROUTER_MODEL=openrouter/free
MAX_AI_SUPPORT_MESSAGES=5
