# SmartServe Mobile - Expo Environment Configuration
#
# IMPORTANT: On a physical phone, localhost/127.0.0.1 refers to the PHONE itself,
# NOT the development PC. You MUST use the PC's LAN IPv4 address.
#
# How to find your PC's LAN IP:
#   Windows: run `ipconfig` and look for the Wi-Fi "IPv4 Address"
#   macOS/Linux: run `ifconfig` and look for the Wi-Fi adapter IP
#
# Example (replace with your actual PC LAN IP):
EXPO_PUBLIC_API_BASE_URL=http://YOUR_PC_LAN_IP:8000/api/v1
#
# Current known development IP (update when your IP changes):
# EXPO_PUBLIC_API_BASE_URL=http://172.20.10.2:8000/api/v1
